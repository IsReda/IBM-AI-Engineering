# ==============================================================
# Whitelist approach — ignore everything, then allow only what
# belongs in the public portfolio repo.
# ==============================================================

# Block everything by default
*

# Allow folders (so git can traverse into them)
!*/

# Allow notebook files
!**/*.ipynb
!**/*.py

# Allow repo essentials
!.gitignore
!README.md

# macOS junk (belt + suspenders)
.DS_Store
**/.DS_Store
